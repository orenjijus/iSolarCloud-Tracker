  create view "MMSR"."public"."stg_fusionsolar__perf_unpivoted__dbt_tmp"
    
    
  as (
    

-- Unpivot FusionSolar historical data from JSONB to long format
SELECT 
    h.collect_time as timestamp,
    h.dev_id,
    d.dev_name as device_name,
    d.plant_code,
    p.plant_name,
    metric_id,
    (metric_value#>> '{}')::numeric as metric_value
FROM (
